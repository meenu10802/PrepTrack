<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= topic %> Secrets - PrepTrack</title>
    <link href="https://fonts.googleapis.com/css2?family=Bubblegum+Sans&family=Roboto+Slab:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <div class="bubbles">
        <div class="bubble" style="left: 10%; width: 20px; height: 20px; animation-duration: 8s;"></div>
        <div class="bubble" style="left: 20%; width: 15px; height: 15px; animation-duration: 10s; animation-delay: 1s;"></div>
        <div class="bubble" style="left: 30%; width: 25px; height: 25px; animation-duration: 9s; animation-delay: 2s;"></div>
        <div class="bubble" style="left: 40%; width: 18px; height: 18px; animation-duration: 7s;"></div>
        <div class="bubble" style="left: 50%; width: 22px; height: 22px; animation-duration: 11s; animation-delay: 3s;"></div>
        <div class="bubble" style="left: 60%; width: 17px; height: 17px; animation-duration: 8s; animation-delay: 4s;"></div>
        <div class="bubble" style="left: 70%; width: 20px; height: 20px; animation-duration: 9s;"></div>
        <div class="bubble" style="left: 80%; width: 16px; height: 16px; animation-duration: 10s; animation-delay: 2s;"></div>
        <div class="bubble" style="left: 90%; width: 23px; height: 23px; animation-duration: 7s; animation-delay: 1s;"></div>
    </div>
    <nav>
        <div class="navbar">
            <a href="/">PrepTrack</a>
            <div>
                <a href="/home">Home</a>
                <a href="/logout">Logout</a>
            </div>
        </div>
    </nav>

    <section class="topic-section concepts-dashboard">
        <div class="concepts-topbar">
            <h2 class="concepts-title"><%= topic %> Secrets</h2>
            <div class="concepts-actions">
                <button type="button" class="btn-weak-analyzer" id="btn-weak-analyzer">Weak Analyzer</button>
                <button type="button" class="btn-assistant" id="btn-assistant"><span class="assistant-icon" aria-hidden="true">🤖</span> Assistant</button>
                <button type="button" class="btn-revision-planner" id="btn-revision-planner">Revision Planner</button>
            </div>
        </div>

        <div class="concepts-divider"></div>

        <div class="progress-donut-block">
            <p id="progress-text" class="progress-label">Progress: 0%</p>
            <div class="donut-legend-chart">
                <div class="donut-legend" aria-hidden="true">
                    <div class="donut-legend-row"><span class="swatch swatch-done"></span> Completed</div>
                    <div class="donut-legend-row"><span class="swatch swatch-left"></span> Remaining</div>
                </div>
                <div class="chart-container chart-container-donut">
                    <canvas id="completion-chart" width="220" height="220"></canvas>
                </div>
            </div>
            <h4 class="interview-heading">Interview Questions</h4>
        </div>

        <div class="concepts-section">
            <ol id="question-list"></ol>
        </div>
    </section>

    <div id="modal-weak" class="modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="weak-modal-title">
        <div class="modal-card modal-wide">
            <div class="modal-head">
                <h3 id="weak-modal-title">Weak Area Analyzer</h3>
                <button type="button" class="modal-close" data-close="modal-weak">Close</button>
            </div>
            <div class="weak-insights-bar">
                <h4 class="weak-sub">Insights</h4>
                <button type="button" class="btn-refresh-insights" id="btn-refresh-insights">Refresh Insights</button>
            </div>
            <p id="weak-summary" class="weak-summary-text">Loading insights…</p>
            <div id="weak-areas-list" class="weak-areas-list"></div>
        </div>
    </div>

    <div id="modal-planner" class="modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="planner-modal-title">
        <div class="modal-card modal-planner">
            <div class="modal-head">
                <h3 id="planner-modal-title">Revision Planner</h3>
                <button type="button" class="modal-close" data-close="modal-planner">Close</button>
            </div>
            <p class="planner-hint">Pick a date and time, then add questions from the bank. You can schedule multiple questions together.</p>
            <label class="planner-date-label">Revision date &amp; time</label>
            <div class="planner-datetime-row">
                <input type="date" id="revision-date-input" class="revision-date-input" aria-label="Revision date">
                <input type="time" id="revision-time-input" class="revision-time-input" aria-label="Revision time" title="Reminder time">
            </div>
            <div class="planner-panels">
                <div class="planner-panel">
                    <h4 class="planner-panel-title">Question Bank</h4>
                    <input type="search" id="planner-search" class="planner-search" placeholder="Search questions…" autocomplete="off">
                    <div id="planner-bank" class="planner-scroll"></div>
                </div>
                <div class="planner-panel">
                    <h4 class="planner-panel-title">Plan for selected date &amp; time</h4>
                    <div id="planner-selected-summary" class="planner-selected-summary">0 question(s) selected</div>
                    <div id="planner-selected" class="planner-scroll"></div>
                </div>
            </div>
            <div class="planner-footer">
                <button type="button" class="btn-save-plan" id="btn-save-revision-plan">Save Revision Plan</button>
            </div>
        </div>
    </div>

    <div id="modal-assistant" class="modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="assistant-modal-title">
        <div class="modal-card modal-assistant">
            <div class="modal-head">
                <h3 id="assistant-modal-title">PrepTrack Assistant</h3>
                <div class="assistant-head-actions">
                    <button type="button" class="btn-assistant-secondary" id="btn-assistant-history" aria-expanded="false" aria-controls="assistant-history-panel">Chat history</button>
                    <button type="button" class="btn-assistant-secondary" id="btn-assistant-new-chat">New chat</button>
                    <button type="button" class="modal-close" data-close="modal-assistant">Close</button>
                </div>
            </div>
            <div id="assistant-history-panel" class="assistant-history-panel" style="display: none;" role="region" aria-label="Previous chats">
                <p class="assistant-history-hint">Open a saved conversation. New messages are stored for your account.</p>
                <div id="assistant-history-list" class="assistant-history-list"></div>
            </div>
            <h4 class="assistant-sub">Ask Anything</h4>
            <div id="assistant-chat" class="assistant-chat">
                <div class="assistant-msg assistant-msg-bot" data-welcome="true">Hi, I am your PrepTrack assistant. Ask me about progress, weak areas, or revision planning.</div>
            </div>
            <div class="assistant-input-row">
                <input type="text" id="assistant-input" class="assistant-input" placeholder="Type your question…" autocomplete="off">
                <button type="button" class="btn-assistant-send" id="btn-assistant-send">Send</button>
            </div>
        </div>
    </div>

    <script>
        const userId = '<%= userId %>';
        const topic = '<%= rawTopic %>';
        function getUserId() { return userId; }
    </script>
    <script src="/js/concepts.js"></script>
</body>
</html>
